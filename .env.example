# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# PostgreSQL connection string, read by prisma.config.ts (CLI) and src/lib/db.ts (app).
# For local development, point this at a Neon BRANCH of the crosswise project,
# not the primary branch — the primary holds real user data (see #57).
# Create one in the Neon console (Branches -> New branch, e.g. "dev") and copy
# its connection string. Same for a local Postgres if you prefer:
# postgresql://user:password@localhost:5432/crosswise
DATABASE_URL=""

# Shared sign-in (ADR-009). Production defaults are built in; set these for local
# development, running the accounts service from the buildyouralpaca repo on :3100.
# ACCOUNTS_URL=http://localhost:3100
# APP_URL=http://localhost:3001

# Shared with the accounts service; it signs the account-deleted webhook with it.
# Production: a random value (openssl rand -base64 32), marked Sensitive in Vercel.
ACCOUNT_WEBHOOK_SECRET=""
